{
  "schemaVersion": 1,
  "description": "License disables capability only — never destroys data. Machine SoT for edition entitlements.",
  "rule": {
    "disable": "capability + public-api surface + UI entry",
    "never": [
      "delete history",
      "mutate journal",
      "strip backup",
      "block export of owned data"
    ]
  },
  "editions": {
    "loan-only": {
      "capabilities": [
        "loan.*"
      ],
      "requiresAccountsUi": false,
      "sharedCore": true,
      "reports": [
        "loan.statement",
        "posted.journal"
      ]
    },
    "crypto-only": {
      "capabilities": [
        "crypto.*"
      ],
      "requiresAccountsUi": false,
      "sharedCore": true,
      "reports": [
        "crypto.holdings",
        "posted.journal"
      ]
    },
    "stocks-only": {
      "capabilities": [
        "stocks.*"
      ],
      "requiresAccountsUi": false,
      "sharedCore": true,
      "reports": [
        "stocks.holdings",
        "posted.journal"
      ]
    },
    "funds-only": {
      "capabilities": [
        "funds.*"
      ],
      "requiresAccountsUi": false,
      "sharedCore": true,
      "reports": [
        "funds.holdings",
        "posted.journal"
      ]
    },
    "metals-only": {
      "capabilities": [
        "metals.*"
      ],
      "requiresAccountsUi": false,
      "sharedCore": true,
      "reports": [
        "metals.holdings",
        "posted.journal"
      ]
    },
    "full": {
      "capabilities": [
        "*"
      ],
      "requiresAccountsUi": true,
      "sharedCore": true,
      "reports": [
        "*"
      ]
    }
  },
  "entitlement": {
    "storage": "local signed license blob (offline-valid)",
    "validation": "public-api boundary before command execution",
    "gracePeriodDays": null,
    "expiry": "commands for unlicensed capability return LICENSE_REQUIRED; data remains readable",
    "upgrade": "add capabilities; no migration of economics",
    "downgrade": "remove capabilities only; history export/rebuild remain available",
    "historicalReadability": true,
    "backupCompatibility": "backup/restore independent of current entitlement"
  },
  "status": "SPEC_LOCKED"
}
