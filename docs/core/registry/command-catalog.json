{
  "schemaVersion": 2,
  "description": "Machine-only canonical command IDs. One ID per semantic command. Plural feature prefix (funds not fund).",
  "naming": {
    "pattern": "<feature>.<verbOrVerbNoun>",
    "featurePrefixes": [
      "accounts",
      "income",
      "expense",
      "cheque",
      "loan",
      "crypto",
      "stocks",
      "funds",
      "metals",
      "assets",
      "budget",
      "goal",
      "bill",
      "tax"
    ],
    "forbiddenAliases": {
      "loan.payment": "loan.recordPayment",
      "fund.subscribe": "funds.subscribe",
      "fund.redeem": "funds.redeem",
      "fund.distribution": "funds.distribute"
    }
  },
  "commands": {
    "crypto.buy": {
      "owner": "docs/modules/crypto.md",
      "capability": "crypto.buy",
      "status": "IMPLEMENTED",
      "tests": [
        "src/features/crypto/tests/buy.test.js"
      ],
      "card": {
        "purpose": "Buy crypto; module default fee reduce_received_quantity",
        "requestFields": [
          "operationId",
          "instrumentId",
          "quantity",
          "price",
          "currency",
          "feeAmount?",
          "feeQuantity?",
          "networkId?"
        ],
        "validation": [],
        "journalMapping": "Core journal via runAtomicFinancialOperation",
        "feeMapping": "Fee Engine when fees present",
        "fx": "book base from settings; amountInBase = amount × rate",
        "costBasis": "n/a",
        "dbWrites": [
          "inv_crypto_*",
          "fin_*"
        ],
        "transactionBoundary": "single SQLite transaction via withinTransaction",
        "idempotency": "operationId + canonical economic hash",
        "reversal": "new inverse operation; no in-place rewrite",
        "result": "operationId + domainResult",
        "errors": [],
        "fixtureRefs": [],
        "invariants": [
          "posted journal ≥2 lines",
          "balanced base"
        ]
      }
    },
