{
  "id": "CORE-ACCOUNTING-KERNEL-V1",
  "version": "1.0.0",
  "note": "Deterministic economics only — no random ids or wall-clock timestamps in expected",
  "cases": [
    {
      "id": "same-currency-balanced",
      "input": {
        "baseCurrency": "IRR",
        "journal": [
          {
            "side": "debit",
            "amount": "100",
            "currency": "IRR",
            "accountId": "cash",
            "amountInBase": "100",
            "exchangeRateToBase": "1"
          },
          {
            "side": "credit",
            "amount": "100",
            "currency": "IRR",
            "accountId": "income",
            "amountInBase": "100",
            "exchangeRateToBase": "1"
          }
        ]
      },
      "expected": {
        "status": "pass",
        "errors": []
      }
    },
    {
      "id": "same-currency-unbalanced",
      "input": {
        "baseCurrency": "IRR",
        "journal": [
          {
            "side": "debit",
            "amount": "100",
            "currency": "IRR",
            "accountId": "cash",
            "amountInBase": "100",
            "exchangeRateToBase": "1"
          },
          {
            "side": "credit",
            "amount": "90",
            "currency": "IRR",
            "accountId": "income",
            "amountInBase": "90",
            "exchangeRateToBase": "1"
          }
        ]
      },
      "expected": {
        "status": "reject",
        "errors": [
          "INV_JOURNAL_UNBALANCED"
        ]
      }
    },
    {
