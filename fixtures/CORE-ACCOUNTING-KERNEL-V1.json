          {
            "side": "credit",
            "amount": "100",
            "currency": "IRR",
            "accountId": "income",
            "amountInBase": "200",
            "exchangeRateToBase": "2"
          }
        ]
      },
      "expected": {
        "status": "reject",
        "errors": [
          "INV_JOURNAL_SAME_CURRENCY_FX_NOT_1"
        ]
      }
    },
    {
