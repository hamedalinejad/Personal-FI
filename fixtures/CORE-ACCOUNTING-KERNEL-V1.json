{
  "id": "CORE-ACCOUNTING-KERNEL-V1",
  "version": "1.0.0",
  "note": "Deterministic economics only — no random ids or wall-clock timestamps in expected",
  "cases": [
    {
      "id": "same-currency-balanced",
      "input": {
        "baseCurrency": "IRR",
        "journal": [
          { "side": "debit", "amount": "100", "currency": "IRR", "accountId": "cash", "amountInBase": "100", "exchangeRateToBase": "1" },
          { "side": "credit", "amount": "100", "currency": "IRR", "accountId": "income", "amountInBase": "100", "exchangeRateToBase": "1" }
        ]
      },
      "expected": { "status": "pass", "errors": [] }
    },
    {
      "id": "same-currency-unbalanced",
      "input": {
        "baseCurrency": "IRR",
        "journal": [
          { "side": "debit", "amount": "100", "currency": "IRR", "accountId": "cash", "amountInBase": "100", "exchangeRateToBase": "1" },
          { "side": "credit", "amount": "90", "currency": "IRR", "accountId": "income", "amountInBase": "90", "exchangeRateToBase": "1" }
        ]
      },
      "expected": { "status": "reject", "errors": ["INV_JOURNAL_UNBALANCED"] }
    },
    {
      "id": "fx-same-currency-not-1",
      "input": {
        "baseCurrency": "IRR",
        "posted": true,
        "journal": [
          { "side": "debit", "amount": "100", "currency": "IRR", "accountId": "cash", "amountInBase": "200", "exchangeRateToBase": "2" },
          { "side": "credit", "amount": "100", "currency": "IRR", "accountId": "income", "amountInBase": "200", "exchangeRateToBase": "2" }
        ]
      },
      "expected": { "status": "reject", "errors": ["INV_JOURNAL_SAME_CURRENCY_FX_NOT_1"] }
    },
    {
      "id": "reversal-inverse",
      "input": {
        "baseCurrency": "IRR",
        "journal": [
          { "side": "debit", "amount": "100", "currency": "IRR", "accountId": "cash", "amountInBase": "100", "exchangeRateToBase": "1" },
          { "side": "credit", "amount": "100", "currency": "IRR", "accountId": "income", "amountInBase": "100", "exchangeRateToBase": "1" }
        ]
      },
      "expected": {
        "status": "pass",
        "inverse": [
          { "side": "credit", "amount": "100", "accountId": "cash" },
          { "side": "debit", "amount": "100", "accountId": "income" }
        ]
      }
    }
  ]
}
